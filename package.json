{
  "name": "onyx-pdf",
  "productName": "OnyxPDF",
  "version": "1.0.2",
  "description": "OnyxPDF",
  "main": "src/main/main.js",
  "author": "Friday",
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.2",
    "http-proxy-agent": "^9.1.0",
    "ms": "^2.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "pptxgenjs": "^4.0.1"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.onyx.pdf",
    "productName": "OnyxPDF",
    "directories": {
      "output": "dist_out"
    },
    "files": [
      "src/**/*",
      "node_modules/fflate/**",
      "node_modules/pdfjs-dist/**",
      "node_modules/pdf-lib/**",
      "node_modules/@pdf-lib/fontkit/dist/fontkit.umd.min.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDF Document",
          "mimeType": "application/pdf",
          "role": "Viewer",
          "rank": 1
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OnyxPDF Setup ${version}.exe"
    }
  }
}
